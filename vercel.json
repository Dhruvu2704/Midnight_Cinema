{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/backend/vercel_app.py"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ],
  "functions": {
    "backend/vercel_app.py": {
      "maxDuration": 30,
      "excludeFiles": "{frontend/**,public/**,data/raw/**,backend/midnight_cinema.db,backend/__pycache__/**,**/__pycache__/**,venv/**,.venv/**,**/*.pyc}"
    }
  }
}
